{
    "catalog": "https://s3-west.nrp-nautilus.io/public-data/stac/catalog.json",
    "titiler_url": "https://titiler.nrp-nautilus.io",
    "mcp_url": "https://duckdb-mcp.nrp-nautilus.io/mcp",
    "auto_approve": true,
    "draw_enabled": true,
    "upload_enabled": true,
    "charts": {
        "enabled": true
    },
    "geocoder": {
        "provider": "nominatim",
        "search_box": true
    },
    "sidebar": {
        "enabled": true,
        "chat_title": "Planning assistant"
    },
    "view": {
        "center": [
            -120.6,
            39.4
        ],
        "zoom": 8
    },
    "links": {
        "github": "https://github.com/SchmidtDSE/forsys-agent",
        "docs": "about.html",
        "carbon": true
    },
    "llm": {
        "user_provided": true,
        "default_endpoint": "https://openrouter.ai/api/v1",
        "models": [
            {
                "value": "~deepseek/deepseek-v4-flash-latest",
                "label": "DeepSeek V4 Flash Latest"
            },
            {
                "value": "anthropic/claude-sonnet-5",
                "label": "Claude Sonnet 5"
            },
            {
                "value": "google/gemini-3.5-flash-lite",
                "label": "Gemini 3.5 Flash Lite"
            },
            {
                "value": "z-ai/glm-5.2",
                "label": "GLM-5.2"
            }
        ]
    },
    "welcome": {
        "message": "A proof of principle: the ForSys greedy spatial heuristic for fuel-treatment planning, executed entirely as DuckDB SQL over an H3 hex grid. Set a planning area three ways \u2014 name an existing polygon (a national forest, a subwatershed, a county), draw one with the polygon tool, or upload a GeoJSON. The About link at the bottom of this panel explains how the algorithm is implemented. Try asking:",
        "examples": [
            "Build a 5-year fuel treatment plan for Tahoe National Forest: 8 project areas, weight WUI protection 0.4, fuel hazard 0.35, irrecoverable carbon 0.25.",
            "Use the Fordyce Creek subwatershed as the planning area and rank its top 3 project areas.",
            "I drew a polygon on the map \u2014 treat that as the planning area and prioritize within it.",
            "Rerun the prioritization weighting carbon at 0.6 instead, and tell me which project areas changed.",
            "Which of the top project areas overlap fuels treatments USFS already completed since 2015 in the FACTS record?",
            "Compare the top 8 project areas for Tahoe vs Eldorado National Forest under the same weights."
        ]
    },
    "collections": [
        {
            "collection_id": "pad-us-4.1-fee",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-padus/padus-4-1/fee/stac-collection.json",
            "assets": [
                {
                    "id": "fee-pmtiles",
                    "alias": "national-forests",
                    "display_name": "National Forests \u2014 GAP 3 multi-use (planning area)",
                    "group": "Planning area",
                    "visible": true,
                    "default_style": {
                        "fill-color": "#2E7D32",
                        "fill-opacity": 0.18
                    },
                    "outline_style": {
                        "line-color": "#1B5E20",
                        "line-width": 1.2
                    },
                    "default_filter": [
                        "==",
                        [
                            "get",
                            "Des_Tp"
                        ],
                        "NF"
                    ],
                    "tooltip_fields": [
                        "Unit_Nm",
                        "Mang_Name",
                        "GAP_Sts",
                        "GIS_Acres"
                    ]
                }
            ]
        },
        {
            "collection_id": "pad-us-4.1-combined",
            "collection_url": "https://s3-west.nrp-nautilus.io/public-padus/padus-4-1/combined/stac-collection.json",
            "assets": [
                {
                    "id": "combined-pmtiles",
