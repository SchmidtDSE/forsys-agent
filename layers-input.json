                                "Ib"
                            ],
                            true,
                            false
                        ]
                    ],
                    "tooltip_fields": [
                        "Unit_Nm",
                        "GAP_Sts",
                        "Des_Tp",
                        "IUCN_Cat",
                        "Mang_Name"
